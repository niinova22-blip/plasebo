# Google oturum açma istemci kimlikleri.
#
# Bu dosyayı `.env` olarak kopyala ve Google Cloud Console'dan aldığın
# kimlikleri yaz. `.env` git'e girmez; EAS derlemelerinde aynı değerler
# EAS ortam değişkeni olarak tanımlanmalıdır:
#
#   eas env:create --name EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID --value ... --visibility plaintext
#
# EXPO_PUBLIC_ öneki taşıyan değerler istemci paketine gömülür. Bunlar
# gizli anahtar değildir (OAuth istemci kimliği herkese açıktır), ancak
# istemci gizli anahtarı (client secret) hiçbir zaman buraya yazılmamalıdır.
#
# Giriş native Google Sign-In ile yapılır. Android'de kullanılan kimlik
# koda yazılmaz: Google, paket adı (com.plasebo.app) ile derleme imzasının
# SHA-1 parmak izini Cloud Console'daki Android istemcisiyle eşleştirir.
# Yani Android istemcisi konsolda MUTLAKA oluşturulmalı, ama buraya
# yalnızca Web (ve varsa iOS) kimliği girilir.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Geliştirme derlemesinde ücretsiz kademeyi zorlar. 1 yapılırsa uygulama
# Plus'ı satın almamış bir kullanıcı gibi davranır: günde 1 yüz taraması,
# nefes analizi kapalı, 24 saatlik döngü kilitli, seans sonunda reklam.
#
# Plus satın almış bir hesapta ücretsiz kademenin yolları başka türlü
# denenemiyor; bu bayrak onları satın alma yapmadan açıp kapatıyor.
# `__DEV__` koşulu yüzünden yayın derlemesinde etkisi yoktur
# (bkz. src/constants/devTier.ts).
EXPO_PUBLIC_FORCE_FREE_TIER=

# AdMob test cihazı kimliği. TestFlight derlemesinde gerçek reklam yerine
# test reklamı almak için; virgülle ayrılmış birden fazla kimlik olabilir.
EXPO_PUBLIC_ADS_TEST_DEVICE_ID=
