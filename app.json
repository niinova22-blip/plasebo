{
  "expo": {
    "name": "Plasebo",
    "slug": "plasebo",
    "version": "1.0.0",
    "description": "Her gün bilimsel görünümlü ama tamamen plasebo olan bir ritüel. Şeffaflık uygulamanın kendisidir.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "plasebo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F6F2",
    "primaryColor": "#0E0E12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plasebo.app"
    },
    "android": {
      "package": "com.plasebo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E0E12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#7B6EF6",
          "defaultChannel": "plasebo-daily",
          "enableBackgroundRemoteNotifications": false,
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E12",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0E12"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "./plugins/withUploadKeystore",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "./plugins/withWidget"
    ]
  }
}
